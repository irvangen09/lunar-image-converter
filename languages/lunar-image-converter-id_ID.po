#. Plugin Name of the plugin
#: lunar-image-converter.php
msgid "Lunar Image Converter"
msgstr "Lunar Image Converter"

#. Plugin URI of the plugin
#: lunar-image-converter.php
msgid "https://github.com/irvangen09/lunar-image-converter"
msgstr "https://github.com/irvangen09/lunar-image-converter"

#. Description of the plugin
#: lunar-image-converter.php
msgid ""
"Converts JPEG and PNG images to WebP or AVIF on upload and replaces the "
"originals."
msgstr ""
"Mengonversi gambar JPEG dan PNG menjadi WebP atau AVIF saat diunggah dan "
"menggantikan file aslinya."

#. Author of the plugin
#: lunar-image-converter.php
msgid "Irvan Noerfazri"
msgstr "Irvan Noerfazri"

#: includes/Admin/BulkController.php:209
msgid "You do not have permission to do this."
msgstr "Anda tidak memiliki izin untuk melakukan ini."

#: includes/Admin/BulkController.php:220 includes/Admin/BulkPanel.php:64
msgid ""
"The saved output format is not supported on this server. Choose another "
"format and save the settings first."
msgstr ""
"Format keluaran yang tersimpan tidak didukung di server ini. Pilih format "
"lain dan simpan pengaturan terlebih dahulu."

#: includes/Admin/BulkController.php:223 includes/Admin/BulkPanel.php:66
msgid "Turn on JPEG or PNG in the settings and save them first."
msgstr "Aktifkan JPEG atau PNG di pengaturan dan simpan terlebih dahulu."

#: includes/Admin/BulkPanel.php:61
msgid "Convert existing images"
msgstr "Konversi gambar yang sudah ada"

#: includes/Admin/BulkPanel.php:68
msgid ""
"Converts the images that are already in your media library, one at a time, "
"with the saved settings. Save the settings above first."
msgstr ""
"Mengonversi gambar yang sudah ada di pustaka media Anda, satu per satu, "
"dengan pengaturan yang tersimpan. Simpan pengaturan di atas terlebih dahulu."

#: includes/Admin/BulkPanel.php:70
msgid ""
"Each converted image replaces its original files, and its address is "
"replaced in the content of your posts and pages. Keep this tab open until "
"the work is done. If you close it, the work stops, and images converted so "
"far stay converted. Images that are not smaller as WebP or AVIF are left as "
"they are."
msgstr ""
"Setiap gambar yang dikonversi menggantikan file aslinya, dan alamatnya "
"diganti di isi tulisan dan halaman Anda. Biarkan tab ini tetap terbuka "
"sampai proses selesai. Jika Anda menutupnya, proses berhenti, dan gambar "
"yang sudah dikonversi tetap terkonversi. Gambar yang tidak menjadi lebih "
"kecil sebagai WebP atau AVIF dibiarkan apa adanya."

#: includes/Admin/BulkPanel.php:75
msgid "I have backed up my uploads folder and my database."
msgstr "Saya sudah mencadangkan folder uploads dan database saya."

#: includes/Admin/BulkPanel.php:79
msgid ""
"Empty alt text of these images is also filled from the file name, as set "
"above."
msgstr ""
"Teks alternatif yang kosong pada gambar-gambar ini juga diisi dari nama "
"file, sesuai pengaturan di atas."

#: includes/Admin/BulkPanel.php:81
msgid "Counting images…"
msgstr "Menghitung gambar…"

#: includes/Admin/BulkPanel.php:83
msgid "Convert images"
msgstr "Konversi gambar"

#: includes/Admin/BulkPanel.php:84
msgid "Try again: skipped, failed and unfinished images"
msgstr "Coba lagi: gambar yang dilewati, gagal, dan belum selesai"

#: includes/Admin/BulkPanel.php:85
msgid "Stop"
msgstr "Berhenti"

#: includes/Admin/BulkPanel.php:90
msgid "Converting existing images needs JavaScript."
msgstr "Mengonversi gambar yang sudah ada memerlukan JavaScript."

#. translators: 1: number of images done, 2: number of images in total.
#: includes/Admin/BulkPanel.php:113
#, php-format
msgid "Converting… %1$s of %2$s"
msgstr "Mengonversi… %1$s dari %2$s"

#. translators: 1: converted, 2: skipped, 3: failed, 4: space saved, for
#. example 3.2 MB.
#: includes/Admin/BulkPanel.php:115
#, php-format
msgid "Done. Converted: %1$s. Skipped: %2$s. Failed: %3$s. Space saved: %4$s."
msgstr ""
"Selesai. Dikonversi: %1$s. Dilewati: %2$s. Gagal: %3$s. Ruang yang dihemat: "
"%4$s."

#. translators: 1: converted, 2: skipped, 3: failed, 4: space saved, for
#. example 3.2 MB.
#: includes/Admin/BulkPanel.php:117
#, php-format
msgid ""
"Stopped. Converted: %1$s. Skipped: %2$s. Failed: %3$s. Space saved: %4$s."
msgstr ""
"Dihentikan. Dikonversi: %1$s. Dilewati: %2$s. Gagal: %3$s. Ruang yang "
"dihemat: %4$s."

#. translators: %s: number of images that got alt text.
#: includes/Admin/BulkPanel.php:119
#, php-format
msgid "Alt text added: %1$s."
msgstr "Teks alternatif ditambahkan: %1$s."

#: includes/Admin/BulkPanel.php:120
msgid ""
"The request failed. Check your connection and try again. Images already "
"converted stay converted."
msgstr ""
"Permintaan gagal. Periksa koneksi Anda dan coba lagi. Gambar yang sudah "
"dikonversi tetap terkonversi."

#. translators: 1: attachment ID, 2: file name, 3: result, for example
#. Converted.
#: includes/Admin/BulkPanel.php:122
#, php-format
msgid "#%1$s %2$s: %3$s"
msgstr "#%1$s %2$s: %3$s"

#. translators: 1: attachment ID, 2: file name, 3: result, for example
#. Skipped, 4: reason.
#: includes/Admin/BulkPanel.php:124
#, php-format
msgid "#%1$s %2$s: %3$s (%4$s)"
msgstr "#%1$s %2$s: %3$s (%4$s)"

#: includes/Admin/MediaStatus.php:85
msgid "Not converted yet"
msgstr "Belum dikonversi"

#. translators: %s: space saved, for example 87 KB.
#: includes/Admin/MediaStatus.php:101
#, php-format
msgid "Converted. Space saved: %s."
msgstr "Dikonversi. Ruang dihemat: %s."

#. translators: 1: result, for example Skipped, 2: reason.
#: includes/Admin/MediaStatus.php:108
#, php-format
msgid "%1$s (%2$s)"
msgstr "%1$s (%2$s)"

#: includes/Admin/MediaStatus.php:132 includes/Admin/MediaStatus.php:159
#: includes/Admin/MediaStatus.php:179 includes/Admin/MediaStatus.php:186
#: includes/Admin/SettingsPage.php:69 includes/Admin/SettingsPage.php:70
msgid "Image Converter"
msgstr "Konverter Gambar"

#: includes/Admin/SettingsPage.php:154
msgid "You do not have permission to access this page."
msgstr "Anda tidak memiliki izin untuk mengakses halaman ini."

#: includes/Admin/SettingsPage.php:166
msgid "Warning:"
msgstr "Peringatan:"

#: includes/Admin/SettingsPage.php:167
msgid ""
"Converted images replace the originals. The original files and their resized"
" copies are deleted from the server, and this cannot be undone. Back up your"
" uploads folder and your database before converting images."
msgstr ""
"Gambar yang dikonversi menggantikan aslinya. File asli beserta salinan "
"ukurannya dihapus dari server, dan ini tidak dapat dibatalkan. Cadangkan "
"folder uploads dan database Anda sebelum mengonversi gambar."

#: includes/Admin/SettingsPage.php:171
msgid "Server support"
msgstr "Dukungan server"

#: includes/Admin/SettingsPage.php:174
msgid "Settings"
msgstr "Pengaturan"

#: includes/Admin/SettingsPage.php:179 includes/Admin/SettingsPage.php:280
msgid "Output format"
msgstr "Format keluaran"

#: includes/Admin/SettingsPage.php:183
msgid "Quality"
msgstr "Kualitas"

#: includes/Admin/SettingsPage.php:187 includes/Admin/SettingsPage.php:365
msgid "Image types"
msgstr "Jenis gambar"

#: includes/Admin/SettingsPage.php:191
msgid "Alt text"
msgstr "Teks alternatif"

#: includes/Admin/SettingsPage.php:220
msgid "AVIF delivery"
msgstr "Pengiriman AVIF"

#. translators: %s: how long ago the server tests ran, for example 5 minutes.
#: includes/Admin/SettingsPage.php:232
#, php-format
msgid "Tested %s ago."
msgstr "Diuji %s yang lalu."

#: includes/Admin/SettingsPage.php:237
msgid "Check again"
msgstr "Periksa lagi"

#. translators: %s: name of the saved format, for example AVIF.
#: includes/Admin/SettingsPage.php:273
#, php-format
msgid ""
"The saved format (%s) is not supported on this server. Choose another format"
" and save."
msgstr ""
"Format yang tersimpan (%s) tidak didukung di server ini. Pilih format lain "
"dan simpan."

#: includes/Admin/SettingsPage.php:313
msgid ""
"Your server cannot encode AVIF. It needs Imagick built with AVIF support, or"
" GD built with AVIF support on PHP 8.1 or later."
msgstr ""
"Server Anda tidak dapat mengenkode AVIF. Server memerlukan Imagick yang "
"dibangun dengan dukungan AVIF, atau GD yang dibangun dengan dukungan AVIF "
"pada PHP 8.1 atau lebih baru."

#. translators: %s: name of the format, for example WebP.
#: includes/Admin/SettingsPage.php:318
#, php-format
msgid "Your server cannot encode %s."
msgstr "Server Anda tidak dapat mengenkode %s."

#: includes/Admin/SettingsPage.php:324
msgid "Slower to encode than WebP."
msgstr "Lebih lambat dienkode daripada WebP."

#. translators: 1: lowest quality, 2: highest quality, 3: default quality.
#: includes/Admin/SettingsPage.php:349
#, php-format
msgid ""
"%1$d to %2$d. Higher means better quality and larger files. Default: %3$d."
msgstr ""
"%1$d sampai %2$d. Semakin tinggi berarti kualitas lebih baik dan file lebih "
"besar. Bawaan: %3$d."

#: includes/Admin/SettingsPage.php:372
msgid "GIF and other image types are never converted."
msgstr "GIF dan jenis gambar lain tidak pernah dikonversi."

#: includes/Admin/SettingsPage.php:387
msgid "Fill empty alt text from the file name"
msgstr "Isi teks alternatif yang kosong dari nama file"

#: includes/Admin/SettingsPage.php:393
msgid ""
"Alt text that is already set is never changed. File names that are not "
"words, such as IMG_20260101_123456, are skipped. Applies to new uploads and "
"to images processed by Convert existing images."
msgstr ""
"Teks alternatif yang sudah terisi tidak pernah diubah. Nama file yang bukan "
"kata, seperti IMG_20260101_123456, dilewati. Berlaku untuk unggahan baru dan"
" untuk gambar yang diproses oleh Konversi gambar yang sudah ada."

#: includes/Admin/StatusText.php:26
msgid "Waiting"
msgstr "Menunggu"

#: includes/Admin/StatusText.php:27
msgid "Converted"
msgstr "Dikonversi"

#: includes/Admin/StatusText.php:28
msgid "Skipped"
msgstr "Dilewati"

#: includes/Admin/StatusText.php:29
msgid "Failed"
msgstr "Gagal"

#: includes/Admin/StatusText.php:30
msgid "Interrupted"
msgstr "Terputus"

#: includes/Admin/StatusText.php:41
msgid "not smaller than the original"
msgstr "tidak lebih kecil dari aslinya"

#: includes/Admin/StatusText.php:42
msgid "too large to convert safely"
msgstr "terlalu besar untuk dikonversi dengan aman"

#: includes/Admin/StatusText.php:43
msgid "not enough time left in the request"
msgstr "waktu permintaan tidak cukup"

#: includes/Admin/StatusText.php:44
msgid "WordPress does not allow this file type"
msgstr "WordPress tidak mengizinkan jenis file ini"

#: includes/Admin/StatusText.php:45
msgid "a file is missing"
msgstr "ada file yang hilang"

#: includes/Admin/StatusText.php:46
msgid "the server could not encode it"
msgstr "server tidak dapat mengenkodenya"

#: includes/Admin/StatusText.php:47
msgid "WordPress could not save the change"
msgstr "WordPress tidak dapat menyimpan perubahan"

#: includes/Admin/StatusText.php:48
msgid "an error occurred"
msgstr "terjadi galat"

#: includes/Admin/StatusText.php:49
msgid "WordPress has no data about this image"
msgstr "WordPress tidak memiliki data tentang gambar ini"

#: includes/Admin/StatusText.php:50
msgid ""
"the old files were kept because the content could not be updated everywhere"
msgstr ""
"file lama dipertahankan karena isi konten tidak dapat diperbarui di semua "
"tempat"

#: includes/Admin/StatusText.php:51
msgid "this server cannot encode the chosen format"
msgstr "server ini tidak dapat mengenkode format yang dipilih"

#: includes/Admin/SupportText.php:35
msgid "Works. A test image was encoded."
msgstr "Berfungsi. Gambar uji berhasil dienkode."

#. translators: %s: name of the format, for example AVIF.
#: includes/Admin/SupportText.php:42
#, php-format
msgid ""
"The server says it supports %s, but a test image could not be encoded. "
"Conversion will probably fail."
msgstr ""
"Server menyatakan mendukung %s, tetapi gambar uji tidak dapat dienkode. "
"Konversi kemungkinan besar akan gagal."

#. translators: %s: name of the format, for example AVIF.
#: includes/Admin/SupportText.php:49
#, php-format
msgid ""
"The server says it supports %s, but the test file it wrote was empty. "
"Conversion will probably fail."
msgstr ""
"Server menyatakan mendukung %s, tetapi file uji yang ditulisnya kosong. "
"Konversi kemungkinan besar akan gagal."

#. translators: %s: name of the format, for example AVIF.
#: includes/Admin/SupportText.php:57
#, php-format
msgid ""
"The server says it supports %s, but the test file was not recognized as an "
"image. Conversion will probably fail."
msgstr ""
"Server menyatakan mendukung %s, tetapi file uji tidak dikenali sebagai "
"gambar. Konversi kemungkinan besar akan gagal."

#. translators: 1: name of the format, for example AVIF, 2: file type that was
#. found, for example image/png.
#: includes/Admin/SupportText.php:64
#, php-format
msgid ""
"The server says it supports %1$s, but the test file was recognized as %2$s. "
"Conversion will probably fail."
msgstr ""
"Server menyatakan mendukung %1$s, tetapi file uji dikenali sebagai %2$s. "
"Konversi kemungkinan besar akan gagal."

#: includes/Admin/SupportText.php:70
msgid "Not supported"
msgstr "Tidak didukung"

#: includes/Admin/SupportText.php:76
msgid "Not tested"
msgstr "Belum diuji"

#: includes/Admin/SupportText.php:93
msgid "Correct. The server sends AVIF files as image/avif."
msgstr "Benar. Server mengirim file AVIF sebagai image/avif."

#: includes/Admin/SupportText.php:97
msgid ""
"Browsers will not show AVIF images. Fix the MIME type for AVIF files (the "
"README explains how), clear your caches and check again."
msgstr ""
"Browser tidak akan menampilkan gambar AVIF. Perbaiki MIME type untuk file "
"AVIF (README menjelaskan caranya), bersihkan cache Anda, lalu periksa lagi."

#: includes/Admin/SupportText.php:102
msgid "Wrong. The server sends AVIF files without a content type."
msgstr "Salah. Server mengirim file AVIF tanpa content type."

#. translators: %s: content type the server sent, for example text/html.
#: includes/Admin/SupportText.php:109
#, php-format
msgid "Wrong. The server sends AVIF files as %s, not as image/avif."
msgstr ""
"Salah. Server mengirim file AVIF sebagai %s, bukan sebagai image/avif."

#. translators: %s: HTTP status code, for example 404.
#: includes/Admin/SupportText.php:116
#, php-format
msgid "Could not check. The test AVIF file answered with HTTP status %s."
msgstr "Tidak dapat diperiksa. File AVIF uji dijawab dengan status HTTP %s."

#. translators: %s: error message.
#: includes/Admin/SupportText.php:123
#, php-format
msgid "Could not check. The site could not fetch its own test file: %s"
msgstr ""
"Tidak dapat diperiksa. Situs tidak dapat mengambil file ujinya sendiri: %s"

#. translators: %s: output format, for example AVIF.
#: includes/Admin/UploadNotice.php:130
#, php-format
msgid "These uploaded images were not converted to %s:"
msgstr "Gambar yang diunggah ini tidak dikonversi ke %s:"

#. translators: %s: number of images that are not listed.
#: includes/Admin/UploadNotice.php:142
#, php-format
msgid "And %s more."
msgstr "Dan %s lainnya."

#: includes/Admin/UploadNotice.php:147
msgid "See the status of every image in the media library"
msgstr "Lihat status setiap gambar di pustaka media"

#. translators: 1: file name, 2: reason the image was not converted.
#: includes/Admin/UploadNotice.php:249
#, php-format
msgid "%1$s: %2$s"
msgstr "%1$s: %2$s"

#. translators: %s: output format, for example AVIF.
#: includes/Admin/UploadWarning.php:83
#, php-format
msgid "Not converted to %s."
msgstr "Tidak dikonversi ke %s."

#. translators: 1: file name, 2: output format, for example AVIF.
#: includes/Admin/UploadWarning.php:85
#, php-format
msgid "\"%1$s\" was not converted to %2$s."
msgstr "\"%1$s\" tidak dikonversi ke %2$s."

#. translators: 1: output format, for example AVIF, 2: reason it was not
#. converted.
#: includes/Admin/UploadWarning.php:91
#, php-format
msgid "Not converted to %1$s: %2$s."
msgstr "Tidak dikonversi ke %1$s: %2$s."

#. translators: 1: file name, 2: output format, for example AVIF, 3: reason it
#. was not converted.
#: includes/Admin/UploadWarning.php:93
#, php-format
msgid "\"%1$s\" was not converted to %2$s: %3$s."
msgstr "\"%1$s\" tidak dikonversi ke %2$s: %3$s."

#: includes/Admin/UploadWarning.php:128
msgid "Why the image was not converted, when it needed to be."
msgstr "Alasan gambar tidak dikonversi, jika memang perlu dikonversi."

#. translators: 1: required PHP version, 2: running PHP version.
#: lunar-image-converter.php:71
#, php-format
msgid ""
"Lunar Image Converter requires PHP %1$s or higher. This site runs PHP %2$s, "
"so the plugin is inactive."
msgstr ""
"Lunar Image Converter memerlukan PHP %1$s atau lebih baru. Situs ini "
"menjalankan PHP %2$s, sehingga plugin tidak aktif."

#. translators: 1: required WordPress version, 2: running WordPress version.
#: lunar-image-converter.php:78
#, php-format
msgid ""
"Lunar Image Converter requires WordPress %1$s or higher. This site runs "
"WordPress %2$s, so the plugin is inactive."
msgstr ""
"Lunar Image Converter memerlukan WordPress %1$s atau lebih baru. Situs ini "
"menjalankan WordPress %2$s, sehingga plugin tidak aktif."

msgid "Old files kept"
msgstr "File lama dipertahankan"

#. translators: %s: HTTP status code, for example 504.
#, php-format
msgid "The server did not finish the request (HTTP %1$s). This is often a time limit or a crash on the server. Images already converted stay converted; an image that was being converted is marked as interrupted. Use \"Try again\" to continue."
msgstr "Server tidak menyelesaikan permintaan (HTTP %1$s). Penyebab yang sering adalah batas waktu atau server yang mogok. Gambar yang sudah dikonversi tetap terkonversi; gambar yang sedang dikonversi ditandai terputus. Gunakan \"Coba lagi\" untuk melanjutkan."

#. translators: 1: what went wrong, 2: converted, 3: skipped, 4: failed.
#, php-format
msgid "%1$s Until then: converted %2$s, skipped %3$s, failed %4$s."
msgstr "%1$s Sampai saat itu: dikonversi %2$s, dilewati %3$s, gagal %4$s."

msgid "Stopping after the current image."
msgstr "Berhenti setelah gambar ini selesai."

#. translators: 1: attachment ID, 2: file name.
#, php-format
msgid "#%1$s %2$s: skipped, another request is working on it"
msgstr "#%1$s %2$s: dilewati, permintaan lain sedang mengerjakannya"
